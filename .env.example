# LLM config shared by S_upd (versioning.normalize_unknown_line) and S_know (knowledge_layer).
# Copy this file to `.env` and fill in a real key — `.env` is gitignored, never commit keys.

# Alibaba Cloud Model Studio (Token Plan, Singapore) — OpenAI-compatible endpoint.
# Model: qwen3.8-flash for fast smoke/debug + S_upd; qwen3.8-max for the final S_know run.
LLM_API_KEY=
LLM_MODEL=qwen3.8-flash
# DashScope intl accepts the sk-ws-… workspace key (verified HTTP 200).
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Alternatives (return 401 invalid_api_key for the sk-ws-… key):
#   https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
#   https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Disable the reasoning/thinking pass for fast smoke/debug runs; set to true for
# higher-quality extraction from qwen3.8-max on the full run (at the cost of latency).
LLM_ENABLE_THINKING=false
# Reasoning models can exceed 60s per call on long legal units; 180s avoids spurious timeouts.
LLM_TIMEOUT=180