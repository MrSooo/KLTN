{"s": "BLDS2015.D621", "p": "type", "o": "dieu"}
{"s": "BLDS2015.D621", "p": "number", "o": "621"}
{"s": "BLDS2015.D621", "p": "heading", "o": "Người không được quyền hưởng di sản"}
{"s": "BLDS2015.D621", "p": "version", "o": 1}
{"s": "BLDS2015.D621", "p": "source_line", "o": 1}
{"s": "BLDS2015.D621.K1", "p": "type", "o": "khoan"}
{"s": "BLDS2015.D621.K1", "p": "number", "o": "1"}
{"s": "BLDS2015.D621.K1", "p": "text", "o": "Những người sau đây không được quyền hưởng di sản:"}
{"s": "BLDS2015.D621.K1", "p": "version", "o": 1}
{"s": "BLDS2015.D621.K1", "p": "source_line", "o": 3}
{"s": "BLDS2015.D621.K1.a", "p": "type", "o": "diem"}
{"s": "BLDS2015.D621.K1.a", "p": "number", "o": "a"}
{"s": "BLDS2015.D621.K1.a", "p": "text", "o": "Người bị kết án về hành vi cố ý xâm phạm tính mạng, sức khỏe hoặc về hành vi ngược đãi nghiêm trọng, hành hạ người để lại di sản, xâm phạm nghiêm trọng danh dự, nhân phẩm của người đó;"}
{"s": "BLDS2015.D621.K1.a", "p": "version", "o": 1}
{"s": "BLDS2015.D621.K1.a", "p": "source_line", "o": 5}
{"s": "BLDS2015.D621.K1.b", "p": "type", "o": "diem"}
{"s": "BLDS2015.D621.K1.b", "p": "number", "o": "b"}
{"s": "BLDS2015.D621.K1.b", "p": "text", "o": "Người vi phạm nghiêm trọng nghĩa vụ nuôi dưỡng người để lại di sản;"}
{"s": "BLDS2015.D621.K1.b", "p": "version", "o": 1}
{"s": "BLDS2015.D621.K1.b", "p": "source_line", "o": 6}
{"s": "BLDS2015.D621.K1.c", "p": "type", "o": "diem"}
{"s": "BLDS2015.D621.K1.c", "p": "number", "o": "c"}
{"s": "BLDS2015.D621.K1.c", "p": "text", "o": "Người bị kết án về hành vi cố ý xâm phạm tính mạng người thừa kế khác nhằm hưởng một phần hoặc toàn bộ phần di sản mà người thừa kế đó có quyền hưởng;"}
{"s": "BLDS2015.D621.K1.c", "p": "version", "o": 1}
{"s": "BLDS2015.D621.K1.c", "p": "source_line", "o": 7}
{"s": "BLDS2015.D621.K1.d", "p": "type", "o": "diem"}
{"s": "BLDS2015.D621.K1.d", "p": "number", "o": "d"}
{"s": "BLDS2015.D621.K1.d", "p": "text", "o": "Người có hành vi lừa dối, cưỡng ép hoặc ngăn cản người để lại di sản trong việc lập di chúc; giả mạo di chúc, sửa chữa di chúc, hủy di chúc, che giấu di chúc nhằm hưởng một phần hoặc toàn bộ di sản trái với ý chí của người để lại di sản."}
{"s": "BLDS2015.D621.K1.d", "p": "version", "o": 1}
{"s": "BLDS2015.D621.K1.d", "p": "source_line", "o": 8}
{"s": "BLDS2015.D621.K2", "p": "type", "o": "khoan"}
{"s": "BLDS2015.D621.K2", "p": "number", "o": "2"}
{"s": "BLDS2015.D621.K2", "p": "text", "o": "Những người quy định tại khoản 1 Điều này vẫn được hưởng di sản, nếu người để lại di sản đã biết hành vi của những người đó, nhưng vẫn cho họ hưởng di sản theo di chúc."}
{"s": "BLDS2015.D621.K2", "p": "version", "o": 1}
{"s": "BLDS2015.D621.K2", "p": "source_line", "o": 10}
{"s": "BLDS2015.D626", "p": "type", "o": "dieu"}
{"s": "BLDS2015.D626", "p": "number", "o": "626"}
{"s": "BLDS2015.D626", "p": "heading", "o": "Quyền của người lập di chúc"}
{"s": "BLDS2015.D626", "p": "text", "o": "Người lập di chúc có quyền sau đây:"}
{"s": "BLDS2015.D626", "p": "version", "o": 1}
{"s": "BLDS2015.D626", "p": "source_line", "o": 12}
{"s": "BLDS2015.D626.K1", "p": "type", "o": "khoan"}
{"s": "BLDS2015.D626.K1", "p": "number", "o": "1"}
{"s": "BLDS2015.D626.K1", "p": "text", "o": "Chỉ định người thừa kế; truất quyền hưởng di sản của người thừa kế."}
{"s": "BLDS2015.D626.K1", "p": "version", "o": 1}
{"s": "BLDS2015.D626.K1", "p": "source_line", "o": 16}
{"s": "BLDS2015.D626.K2", "p": "type", "o": "khoan"}
{"s": "BLDS2015.D626.K2", "p": "number", "o": "2"}
{"s": "BLDS2015.D626.K2", "p": "text", "o": "Phân định phần di sản cho từng người thừa kế."}
{"s": "BLDS2015.D626.K2", "p": "version", "o": 1}
{"s": "BLDS2015.D626.K2", "p": "source_line", "o": 18}
{"s": "BLDS2015.D626.K3", "p": "type", "o": "khoan"}
{"s": "BLDS2015.D626.K3", "p": "number", "o": "3"}
{"s": "BLDS2015.D626.K3", "p": "text", "o": "Dành một phần tài sản trong khối di sản để di tặng, thờ cúng."}
{"s": "BLDS2015.D626.K3", "p": "version", "o": 1}
{"s": "BLDS2015.D626.K3", "p": "source_line", "o": 20}
{"s": "BLDS2015.D626.K4", "p": "type", "o": "khoan"}
{"s": "BLDS2015.D626.K4", "p": "number", "o": "4"}
{"s": "BLDS2015.D626.K4", "p": "text", "o": "Giao nghĩa vụ cho người thừa kế."}
{"s": "BLDS2015.D626.K4", "p": "version", "o": 1}
{"s": "BLDS2015.D626.K4", "p": "source_line", "o": 22}
{"s": "BLDS2015.D626.K5", "p": "type", "o": "khoan"}
{"s": "BLDS2015.D626.K5", "p": "number", "o": "5"}
{"s": "BLDS2015.D626.K5", "p": "text", "o": "Chỉ định người giữ di chúc, người quản lý di sản, người phân chia di sản."}
{"s": "BLDS2015.D626.K5", "p": "version", "o": 1}
{"s": "BLDS2015.D626.K5", "p": "source_line", "o": 24}
{"s": "BLDS2015.D644", "p": "type", "o": "dieu"}
{"s": "BLDS2015.D644", "p": "number", "o": "644"}
{"s": "BLDS2015.D644", "p": "heading", "o": "Người thừa kế không phụ thuộc vào nội dung của di chúc"}
{"s": "BLDS2015.D644", "p": "version", "o": 1}
{"s": "BLDS2015.D644", "p": "source_line", "o": 26}
{"s": "BLDS2015.D644.K1", "p": "type", "o": "khoan"}
{"s": "BLDS2015.D644.K1", "p": "number", "o": "1"}
{"s": "BLDS2015.D644.K1", "p": "text", "o": "Những người sau đây vẫn được hưởng phần di sản bằng hai phần ba suất của một người thừa kế theo pháp luật nếu di sản được chia theo pháp luật, trong trường hợp họ không được người lập di chúc cho hưởng di sản hoặc chỉ cho hưởng phần di sản ít hơn hai phần ba suất đó:"}
{"s": "BLDS2015.D644.K1", "p": "version", "o": 1}
{"s": "BLDS2015.D644.K1", "p": "source_line", "o": 28}
{"s": "BLDS2015.D644.K1.a", "p": "type", "o": "diem"}
{"s": "BLDS2015.D644.K1.a", "p": "number", "o": "a"}
{"s": "BLDS2015.D644.K1.a", "p": "text", "o": "Con chưa thành niên, cha, mẹ, vợ, chồng;"}
{"s": "BLDS2015.D644.K1.a", "p": "version", "o": 1}
{"s": "BLDS2015.D644.K1.a", "p": "source_line", "o": 30}
{"s": "BLDS2015.D644.K1.b", "p": "type", "o": "diem"}
{"s": "BLDS2015.D644.K1.b", "p": "number", "o": "b"}
{"s": "BLDS2015.D644.K1.b", "p": "text", "o": "Con thành niên mà không có khả năng lao động."}
{"s": "BLDS2015.D644.K1.b", "p": "version", "o": 1}
{"s": "BLDS2015.D644.K1.b", "p": "source_line", "o": 31}
{"s": "BLDS2015.D644.K2", "p": "type", "o": "khoan"}
{"s": "BLDS2015.D644.K2", "p": "number", "o": "2"}
{"s": "BLDS2015.D644.K2", "p": "text", "o": "Quy định tại khoản 1 Điều này không áp dụng đối với người từ chối nhận di sản theo quy định tại Điều 620 hoặc họ là những người không có quyền hưởng di sản theo quy định tại khoản 1 Điều 621 của Bộ luật này."}
{"s": "BLDS2015.D644.K2", "p": "version", "o": 1}
{"s": "BLDS2015.D644.K2", "p": "source_line", "o": 33}
{"s": "BLDS2015.D650", "p": "type", "o": "dieu"}
{"s": "BLDS2015.D650", "p": "number", "o": "650"}
{"s": "BLDS2015.D650", "p": "heading", "o": "Những trường hợp thừa kế theo pháp luật"}
{"s": "BLDS2015.D650", "p": "version", "o": 1}
{"s": "BLDS2015.D650", "p": "source_line", "o": 35}
{"s": "BLDS2015.D650.K1", "p": "type", "o": "khoan"}
{"s": "BLDS2015.D650.K1", "p": "number", "o": "1"}
{"s": "BLDS2015.D650.K1", "p": "text", "o": "Thừa kế theo pháp luật được áp dụng trong trường hợp sau đây:"}
{"s": "BLDS2015.D650.K1", "p": "version", "o": 1}
{"s": "BLDS2015.D650.K1", "p": "source_line", "o": 37}
{"s": "BLDS2015.D650.K1.a", "p": "type", "o": "diem"}
{"s": "BLDS2015.D650.K1.a", "p": "number", "o": "a"}
{"s": "BLDS2015.D650.K1.a", "p": "text", "o": "Không có di chúc;"}
{"s": "BLDS2015.D650.K1.a", "p": "version", "o": 1}
{"s": "BLDS2015.D650.K1.a", "p": "source_line", "o": 39}
{"s": "BLDS2015.D650.K1.b", "p": "type", "o": "diem"}
{"s": "BLDS2015.D650.K1.b", "p": "number", "o": "b"}
{"s": "BLDS2015.D650.K1.b", "p": "text", "o": "Di chúc không hợp pháp;"}
{"s": "BLDS2015.D650.K1.b", "p": "version", "o": 1}
{"s": "BLDS2015.D650.K1.b", "p": "source_line", "o": 40}
{"s": "BLDS2015.D650.K1.c", "p": "type", "o": "diem"}
{"s": "BLDS2015.D650.K1.c", "p": "number", "o": "c"}
{"s": "BLDS2015.D650.K1.c", "p": "text", "o": "Những người thừa kế theo di chúc chết trước hoặc chết cùng thời điểm với người lập di chúc; cơ quan, tổ chức được hưởng thừa kế theo di chúc không còn tồn tại vào thời điểm mở thừa kế;"}
{"s": "BLDS2015.D650.K1.c", "p": "version", "o": 1}
{"s": "BLDS2015.D650.K1.c", "p": "source_line", "o": 41}
{"s": "BLDS2015.D650.K1.d", "p": "type", "o": "diem"}
{"s": "BLDS2015.D650.K1.d", "p": "number", "o": "d"}
{"s": "BLDS2015.D650.K1.d", "p": "text", "o": "Những người được chỉ định làm người thừa kế theo di chúc mà không có quyền hưởng di sản hoặc từ chối nhận di sản."}
{"s": "BLDS2015.D650.K1.d", "p": "version", "o": 1}
{"s": "BLDS2015.D650.K1.d", "p": "source_line", "o": 42}
{"s": "BLDS2015.D650.K2", "p": "type", "o": "khoan"}
{"s": "BLDS2015.D650.K2", "p": "number", "o": "2"}
{"s": "BLDS2015.D650.K2", "p": "text", "o": "Thừa kế theo pháp luật cũng được áp dụng đối với các phần di sản sau đây:"}
{"s": "BLDS2015.D650.K2", "p": "version", "o": 1}
{"s": "BLDS2015.D650.K2", "p": "source_line", "o": 44}
{"s": "BLDS2015.D650.K2.a", "p": "type", "o": "diem"}
{"s": "BLDS2015.D650.K2.a", "p": "number", "o": "a"}
{"s": "BLDS2015.D650.K2.a", "p": "text", "o": "Phần di sản không được định đoạt trong di chúc;"}
{"s": "BLDS2015.D650.K2.a", "p": "version", "o": 1}
{"s": "BLDS2015.D650.K2.a", "p": "source_line", "o": 46}
{"s": "BLDS2015.D650.K2.b", "p": "type", "o": "diem"}
{"s": "BLDS2015.D650.K2.b", "p": "number", "o": "b"}
{"s": "BLDS2015.D650.K2.b", "p": "text", "o": "Phần di sản có liên quan đến phần của di chúc không có hiệu lực pháp luật;"}
{"s": "BLDS2015.D650.K2.b", "p": "version", "o": 1}
{"s": "BLDS2015.D650.K2.b", "p": "source_line", "o": 47}
{"s": "BLDS2015.D650.K2.c", "p": "type", "o": "diem"}
{"s": "BLDS2015.D650.K2.c", "p": "number", "o": "c"}
{"s": "BLDS2015.D650.K2.c", "p": "text", "o": "Phần di sản có liên quan đến người được thừa kế theo di chúc nhưng họ không có quyền hưởng di sản, từ chối nhận di sản, chết trước hoặc chết cùng thời điểm với người lập di chúc; liên quan đến cơ quan, tổ chức được hưởng di sản theo di chúc, nhưng không còn tồn tại vào thời điểm mở thừa kế."}
{"s": "BLDS2015.D650.K2.c", "p": "version", "o": 1}
{"s": "BLDS2015.D650.K2.c", "p": "source_line", "o": 48}
{"s": "BLDS2015.D651", "p": "type", "o": "dieu"}
{"s": "BLDS2015.D651", "p": "number", "o": "651"}
{"s": "BLDS2015.D651", "p": "heading", "o": "Người thừa kế theo pháp luật"}
{"s": "BLDS2015.D651", "p": "version", "o": 1}
{"s": "BLDS2015.D651", "p": "source_line", "o": 50}
{"s": "BLDS2015.D651.K1", "p": "type", "o": "khoan"}
{"s": "BLDS2015.D651.K1", "p": "number", "o": "1"}
{"s": "BLDS2015.D651.K1", "p": "text", "o": "Những người thừa kế theo pháp luật được quy định theo thứ tự sau đây:"}
{"s": "BLDS2015.D651.K1", "p": "version", "o": 1}
{"s": "BLDS2015.D651.K1", "p": "source_line", "o": 52}
{"s": "BLDS2015.D651.K1.a", "p": "type", "o": "diem"}
{"s": "BLDS2015.D651.K1.a", "p": "number", "o": "a"}
{"s": "BLDS2015.D651.K1.a", "p": "text", "o": "Hàng thừa kế thứ nhất gồm: vợ, chồng, cha đẻ, mẹ đẻ, cha nuôi, mẹ nuôi, con đẻ, con nuôi của người chết;"}
{"s": "BLDS2015.D651.K1.a", "p": "version", "o": 1}
{"s": "BLDS2015.D651.K1.a", "p": "source_line", "o": 54}
{"s": "BLDS2015.D651.K1.b", "p": "type", "o": "diem"}
{"s": "BLDS2015.D651.K1.b", "p": "number", "o": "b"}
{"s": "BLDS2015.D651.K1.b", "p": "text", "o": "Hàng thừa kế thứ hai gồm: ông nội, bà nội, ông ngoại, bà ngoại, anh ruột, chị ruột, em ruột của người chết; cháu ruột của người chết mà người chết là ông nội, bà nội, ông ngoại, bà ngoại;"}
{"s": "BLDS2015.D651.K1.b", "p": "version", "o": 1}
{"s": "BLDS2015.D651.K1.b", "p": "source_line", "o": 55}
{"s": "BLDS2015.D651.K1.c", "p": "type", "o": "diem"}
{"s": "BLDS2015.D651.K1.c", "p": "number", "o": "c"}
{"s": "BLDS2015.D651.K1.c", "p": "text", "o": "Hàng thừa kế thứ ba gồm: cụ nội, cụ ngoại của người chết; bác ruột, chú ruột, cậu ruột, cô ruột, dì ruột của người chết; cháu ruột của người chết mà người chết là bác ruột, chú ruột, cậu ruột, cô ruột, dì ruột; chắt ruột của người chết mà người chết là cụ nội, cụ ngoại."}
{"s": "BLDS2015.D651.K1.c", "p": "version", "o": 1}
{"s": "BLDS2015.D651.K1.c", "p": "source_line", "o": 56}
{"s": "BLDS2015.D651.K2", "p": "type", "o": "khoan"}
{"s": "BLDS2015.D651.K2", "p": "number", "o": "2"}
{"s": "BLDS2015.D651.K2", "p": "text", "o": "Những người thừa kế cùng hàng được hưởng phần di sản bằng nhau."}
{"s": "BLDS2015.D651.K2", "p": "version", "o": 1}
{"s": "BLDS2015.D651.K2", "p": "source_line", "o": 58}
{"s": "BLDS2015.D651.K3", "p": "type", "o": "khoan"}
{"s": "BLDS2015.D651.K3", "p": "number", "o": "3"}
{"s": "BLDS2015.D651.K3", "p": "text", "o": "Những người ở hàng thừa kế sau chỉ được hưởng thừa kế, nếu không còn ai ở hàng thừa kế trước do đã chết, không có quyền hưởng di sản, bị truất quyền hưởng di sản hoặc từ chối nhận di sản."}
{"s": "BLDS2015.D651.K3", "p": "version", "o": 1}
{"s": "BLDS2015.D651.K3", "p": "source_line", "o": 60}
