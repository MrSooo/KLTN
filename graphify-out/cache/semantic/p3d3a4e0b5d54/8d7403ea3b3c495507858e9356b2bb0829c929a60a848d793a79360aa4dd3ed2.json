{"nodes": [{"id": "method_writing_guide_guide", "label": "Method writing guide (Section 3-4 self-writing guide)", "file_type": "document", "source_file": "method_writing_guide.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contains no English sample sentences because copying cookbook sentences made the draft read as AI-written."}, {"id": "method_writing_guide_placeholder_markers", "label": "Placeholder markers ([CH\u1edc QUY\u1ebeT], [CH\u1edc CODE], [C\u1ea6N S\u1ed0], [KI\u1ec2M], [C\u1ea6N TR\u00cdCH D\u1eaaN])", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "method_writing_guide_terminology_table", "label": "English terminology table (unit, version, directive, delegating provision, check, isolated, proposition, predicate registry)", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "method_writing_guide_ai_symptoms", "label": "Why the draft reads as AI (10 symptoms)", "file_type": "rationale", "source_file": "method_writing_guide.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evidence from DRAFT_PAPER_METHODS_LATEX.pdf: repeated must-openers, italic run-in headings, copied cookbook sentences, design-doc details, uniform paragraph lengths, unused symbols, S3 too long."}, {"id": "method_writing_guide_draft_paper_methods_latex", "label": "DRAFT_PAPER_METHODS_LATEX.pdf", "file_type": "document", "source_file": "method_writing_guide.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "method_writing_guide_work_permit_running_example", "label": "Running example: work permit chain (LC D151, D154, D154.K9, ND152, ND219)", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L54", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One question at four dates yields all four outcomes, so a single example passes through every layer."}, {"id": "method_writing_guide_page_budget", "label": "Page budget (S3 ~2.5 pages, S4 ~4 pages, ~283 lines)", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L104", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "method_writing_guide_problem_c1_c2", "label": "Problem statement with criteria (C1) in-force grounds and (C2) incremental = rebuild", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L165", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "method_writing_guide_version_tuple", "label": "Version v = (u, text, [t_from, t_to), mu) (Eq.1)", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L179", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No overwrite: each change creates a new version."}, {"id": "method_writing_guide_status_function_sigma", "label": "Date status function sigma_v(tau) (Eq.2)", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L190", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Status is computed from the validity interval, not stored, so one version serves every query date."}, {"id": "method_writing_guide_kb_definition", "label": "KB definition K = (D, U, V, E, Delta, P, R) (Definition 1)", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L203", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "method_writing_guide_program_pi_tau", "label": "Program at date tau: Pi_tau (Eq.3)", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L218", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Central equation of the paper; grounds of an answer are src(r) of used rules, which realizes (C1)."}, {"id": "method_writing_guide_scasp", "label": "s(CASP)", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L223", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "method_writing_guide_update_composition", "label": "Update(K,d) = S_know o S_upd o S_str (Eq.4) with Figure 1", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L235", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "method_writing_guide_structural_layer", "label": "Structural layer S_str (4.1): units, references, Delta, explicit exceptions", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L261", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "method_writing_guide_details_accept_condition", "label": "details link acceptance condition (target in Delta, keyword in target) (Eq.5)", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L280", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Second-model agreement pass risks being read as LLM checking LLM; the true machine gate is keyword-in-target. Pending decision."}, {"id": "method_writing_guide_update_engine", "label": "Update engine S_upd (4.2): directives, version operators, affected set", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L291", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most distinctive part of the paper; directive parsing is deterministic with no LLM."}, {"id": "method_writing_guide_version_operators", "label": "Version operators close/open (Eq.6)", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L306", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Order must be stated (cookbook 5.8 flags P4); replace = open o close, directives applied in text order, documents ordered by (t_eff, t_iss, id)."}, {"id": "method_writing_guide_affected_set", "label": "Affected set A(d) = T(d) U N(T(d)) (Eq.7)", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L327", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Number of hops of N is undecided; with 1 hop D151.K1.d falls outside A(ND219)."}, {"id": "method_writing_guide_knowledge_layer", "label": "Knowledge layer S_know (4.3): propositions, predicate registry, implicit exceptions, rules", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L341", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "method_writing_guide_llm_check_table", "label": "Table 2: LLM use points and machine checks", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L346", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "method_writing_guide_proposition_extraction", "label": "Proposition extraction 1.6A f_prop with syllable gate (Eq.8)", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L357", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Syllable gate allows dropping words but not adding words absent from the law; cannot catch reordering or wrong meaning."}, {"id": "method_writing_guide_predicate_reuse", "label": "Predicate registry and reuse 1.6B (Eq.9, k=20 candidates)", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L370", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrong merge is worse than missed split, so reuse is strict; polarity cuc separated from name (A27)."}, {"id": "method_writing_guide_implicit_exceptions", "label": "Implicit exceptions 1.7", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L383", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "method_writing_guide_blocking_rule", "label": "Rules and blocking relation 1.8 b_{e,r} with src(b)=src(e) (Eq.10)", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L390", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "src(b)=src(e) ensures an expired exception leaves Pi_tau, preserving (C1); isolated edges produce no blocking rule."}, {"id": "method_writing_guide_cross_document_conflict", "label": "Cross-document conflict (Article 58, Law 64/2025)", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L411", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "method_writing_guide_date_aware_qa", "label": "Date-aware QA (4.4): question to facts F_q", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L417", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "method_writing_guide_four_outcomes", "label": "Four outcomes ans(q,tau): concluded, rebutted, insufficient, no_answer (Eq.11)", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L425", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "method_writing_guide_delegation_gap", "label": "Gap caused by unfilled Delta (insufficient vs NAF wrong answer)", "file_type": "concept", "source_file": "method_writing_guide.md", "source_location": "L445", "s